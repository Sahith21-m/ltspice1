TEXT -360 -168 Left 2 !.tran 100m
TEXT 64 -144 Left 2 !.meas TRAN t1 WHEN V(vin)=0 FALL=3
TEXT 64 -96 Left 2 !.meas TRAN t2 WHEN V(vout)=0 FALL=3

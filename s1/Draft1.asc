Version 4.1
SHEET 1 880 680
WIRE -320 -80 -352 -80
WIRE -240 -80 -320 -80
WIRE -96 -80 -160 -80
WIRE -64 -80 -96 -80
WIRE -352 -16 -352 -80
WIRE -64 -16 -64 -80
WIRE -64 112 -64 48
WIRE -48 112 -64 112
WIRE -352 128 -352 64
WIRE -48 128 -48 112
FLAG -352 128 0
FLAG -48 128 0
FLAG -320 -80 vin
FLAG -96 -80 vout
SYMBOL res -144 -96 R90
WINDOW 0 0 56 VBottom 2
WINDOW 3 32 56 VTop 2
SYMATTR InstName R1
SYMATTR Value 10k
SYMBOL cap -80 -16 R0
SYMATTR InstName C1
SYMATTR Value 10n
SYMBOL voltage -352 -32 R0
WINDOW 123 0 0 Left 0
WINDOW 39 0 0 Left 0
SYMATTR InstName V1
